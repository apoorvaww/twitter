  "liveNow": false,
  "panels": [
    {
      "title": "API Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(twitter_http_requests_total[1m])) by (method, status_code)",
          "legendFormat": "{{method}} - {{status_code}}"
        }
      ]
    },
    {
      "title": "API P95 Response Latency (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(twitter_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Latency"
        }
      ]
    },
    {
      "title": "BullMQ Waiting Jobs (Queue Depth)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "twitter_queue_waiting_jobs",
          "legendFormat": "{{queue_name}}"
        }
      ]
    },
    {
      "title": "Process Memory (RSS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "twitter_app_process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "RSS Memory (MB)"
        }
      ]
    }
  ],
  "refresh": "5s",
